{
  "name": "BWT Wheeler Lang Study",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsManagement.checkForUpdates": "off",
        "go.useLanguageServer": true
      },
      "extensions": [
        "golang.go"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    }
  },
  "postCreateCommand": "go version && sudo apt-get update && sudo apt-get install -y python3-pip python3-venv && python3 -m pip --version",
  "remoteUser": "vscode"
}
