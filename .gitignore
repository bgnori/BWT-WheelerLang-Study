# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled binary at repo root only
/bwtsearch

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Test data from Project Gutenberg — must NOT be committed to the repo
data/*.txt
data/*.idx
data/*.bin

# FASTA genome data downloaded for indexing tests — must NOT be committed
data/*.fna

# Git source code downloaded for indexing tests — must NOT be committed
data/git-src/

# Kaggle Amazon benchmark data (raw archives/extracted tables) — must NOT be committed
data/kaggle/
data/*.csv
data/*.tsv
data/*.zip

# Keep the data directory itself (with its .gitkeep placeholder)
!data/.gitkeep

# Fake logs generated for benchmark/test data — must NOT be committed
data/fake-logs/
